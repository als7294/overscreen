# Copy to .env and fill in. .env is gitignored.

# Samsung TV on your LAN (Settings > Connection > Network > Network Status > IP Settings)
TV_IP=
# TV identity, so the alert relay only fires for YOUR TV (curl http://<TV_IP>:8001/api/v2/ and copy "id")
TV_DUID=
# This computer's LAN IP, the one entered in the TV's Developer Mode; the TV fetches alert media from it
MAC_LAN_IP=
# Where the TV reaches the Mac alert relay (tools/notify.mjs) and the phone-remote relay
# host:port, e.g. <MAC_LAN_IP>:8795
NOTIFY_HOST=
# host:port of tools/remote-relay.py, e.g. myserver.example.com:7311
REMOTE_HOST=
# ssh host alias used to copy tools/remote.html to the relay server
REMOTE_SSH=
TV_SDB_PORT=26101

# Tizen Studio install location
TIZEN_STUDIO=$HOME/tizen-studio

# Name of the Samsung signing profile in Tizen's Certificate Manager
# (certs themselves live outside this repo, e.g. ~/tizen-certs)
TIZEN_SIGN_PROFILE=samsucks

# Plex server (optional during dev; the app will do PIN login on-device)
PLEX_SERVER_URL=
PLEX_TOKEN=

# Password for the Tizen author cert (tizen certificate -a samsucks -p <pw> -f samsucks)
TIZEN_CERT_PASSWORD=

# Dev builds send logs/perf to tools/devserver.mjs on this host:port
DEV_HOST=

# Dev builds only: skip plex.tv sign-in and use PLEX_SERVER_URL directly
# (works when the server allows unauthenticated LAN access)
DEV_SKIP_LOGIN=0
